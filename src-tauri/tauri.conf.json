{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Courseshelf",
	"version": "0.2.0",
	"identifier": "com.khaled.courseshelf",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Courseshelf",
				"maximized": true,
				"width": 1280,
				"height": 800,
				"minWidth": 960,
				"minHeight": 640
			}
		],
		"security": {
			"csp": {
				"default-src": "'none'",
				"script-src": "'self'",
				"style-src": "'self'",
				"style-src-attr": "'unsafe-inline'",
				"img-src": "'self' blob:",
				"font-src": "'self'",
				"connect-src": "ipc: http://ipc.localhost",
				"media-src": "http://127.0.0.1:*",
				"object-src": "'none'",
				"base-uri": "'none'",
				"form-action": "'none'"
			},
			"devCsp": {
				"default-src": "'none'",
				"script-src": "'self'",
				"style-src": "'self' 'unsafe-inline'",
				"style-src-attr": "'unsafe-inline'",
				"img-src": "'self' blob:",
				"font-src": "'self'",
				"connect-src": "ipc: http://ipc.localhost http://localhost:1420 http://127.0.0.1:1420 ws://localhost:1420 ws://127.0.0.1:1420 ws://localhost:1421 ws://127.0.0.1:1421",
				"media-src": "http://127.0.0.1:*",
				"object-src": "'none'",
				"base-uri": "'none'",
				"form-action": "'none'"
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": ["deb"],
		"shortDescription": "Track your progress through local video courses",
		"category": "Education",
		"linux": {
			"deb": {
				"depends": [
					"gstreamer1.0-libav",
					"gstreamer1.0-plugins-base",
					"gstreamer1.0-plugins-good"
				],
				"recommends": ["gstreamer1.0-plugins-bad"],
				"section": "education"
			}
		},
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
